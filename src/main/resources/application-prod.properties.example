spring.config.activate.on-profile=prod
spring.datasource.url=${DATABASE_URL:jdbc:postgresql://host.docker.internal:5432/yourAwesomeDatabase}
spring.datasource.username=${DATABASE_USERNAME:yourAwesomeUsername}
spring.datasource.password=${DATABASE_PASSWORD:yourEquallyAwesomePassword}

#
#User info.... KeyCloak
#
# Below saves on network bandwidth, however if a key gets compromised, this makes rotating keys more difficult.
#spring.security.oauth2.resourceserver.jwt.jwk-set-uri=${JWK_SET_URI:http://localhost:8080/realms/InventoryNexus/protocol/openid-connect/certs}
spring.security.oauth2.resourceserver.opaquetoken.introspection-uri=${INTROSPECT_URI:http://localhost:8080/realms/InventoryNexus/protocol/openid-connect/token/introspect}
spring.security.oauth2.resourceserver.opaquetoken.client-id=${INTROSPECT_ID:whateveryouthinkisbest}
spring.security.oauth2.resourceserver.opaquetoken.client-secret=${INTROSPECT_SECRET:somecoolkey}

#
# Hashicorp Vault
#
spring.cloud.vault.host=localhost
spring.cloud.vault.port=8200
spring.cloud.vault.schem=http

spring.cloud.vault.authentication=TOKEN
spring.cloud.vault.token=myroot

spring.cloud.vault.fail-fast=false
spring.config.import=optional:vault://

spring.cloud.vault.kv.enabled=true
spring.cloud.vault.kv.backend=secret
spring.cloud.vault.kv.default-context=application

logging.level.org.springframework.cloud.vault=WARN
logging.level.org.springframework.vault=WARN

#
# Port
#
server.port=80