spring.config.activate.on-profile=dev
spring.datasource.url=${dbUrl}
spring.datasource.username=${dbUsername}
spring.datasource.password=${dbPassword}

#
#User info.... KeyCloak
#
#Below saves on network bandwidth, however if a key gets compromised, this makes rotating keys more difficult.
#spring.security.oauth2.resourceserver.jwt.jwk-set-uri=${jwk-uri}
spring.security.oauth2.resourceserver.opaquetoken.introspection-uri=${introspectionUri}
spring.security.oauth2.resourceserver.opaquetoken.client-id=${clientId}
spring.security.oauth2.resourceserver.opaquetoken.client-secret=${clientSecret}

#
#bootstrap our vault
#
spring.cloud.vault.uri=http://localhost:8200
spring.cloud.vault.token=${VAULT_TOKEN}
spring.config.import=vault://secret/inventory-nexus/db,vault://secret/inventory-nexus/keycloak
logging.level.org.springframework.cloud.vault=DEBUG
logging.level.org.springframework.boot.context.config=DEBUG

#
# Port
#
server.port=8080